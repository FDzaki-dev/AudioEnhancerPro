<?xml version="1.0" encoding="UTF-8"?>
<!-- Batch 201 — filter SpotBugs REPORT-ONLY untuk Boomly (adaptasi `config/spotbugs/exclude.xml` template SONIX, Batch 574).
     Hanya membuang NOISE khas bytecode Kotlin/Compose (bukan bug nyata) supaya `laporan-untuk-claude.txt` tetap ringkas.
     Pola yang DIBUANG bisa dipulihkan satu per satu bila ingin dicek ulang (hapus blok `<Match>`-nya). Pattern yang tidak
     disaring (mis. DE_*, RV_*, DM_*, IS2_*, MS_*; SA_*/ST_* hanya disaring pada 2 kelas di blok Batch 205) TETAP dilaporkan. Dipakai hanya lewat
     `./gradlew spotbugsDebug -Pboomly.spotbugs=true` (workflow `android-artifact.yml`); build/rilis biasa tidak menyentuh
     file ini. Pertama jalan di laporan CI run2 (Batch 201): 285 temuan; blok Batch 203 di bawah = hasil triase run2. -->
<FindBugsFilter>
    <!-- Kelas hasil generator: resource R, singleton Compose, lambda/inline sintetis. -->
    <Match>
        <Class name="~.*\.R(\$.*)?"/>
    </Match>
    <Match>
        <Class name="~.*ComposableSingletons.*"/>
    </Match>
    <Match>
        <Class name="~.*\$\$inlined\$.*"/>
    </Match>
    <Match>
        <Class name="~.*\$\$ExternalSyntheticLambda.*"/>
    </Match>

    <!-- Null-check yang disisipkan kompilator Kotlin (Intrinsics.checkNotNull*) dibaca sebagai "redundant". -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE,RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>

    <!-- Kotlin tidak punya checked exception: `catch (e: Exception)` / `catch (e: RuntimeException)` wajar
         (mis. konstruktor AudioEffect yang melempar RuntimeException). -->
    <Match>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>

    <!-- Store lokal "mati" hasil ekspansi fungsi inline / destructuring Kotlin. -->
    <Match>
        <Bug pattern="DLS_DEAD_LOCAL_STORE,DLS_DEAD_LOCAL_STORE_OF_NULL"/>
    </Match>

    <!-- Lambda/objek anonim Kotlin yang menangkap `this`, data class yang mengembalikan List/array apa adanya,
         properti `lateinit`. -->
    <Match>
        <Bug pattern="SIC_INNER_SHOULD_BE_STATIC_ANON,SIC_INNER_SHOULD_BE_STATIC,SIC_INNER_SHOULD_BE_STATIC_NEEDS_THIS"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
    </Match>

    <!-- Cast generik hasil `as`/smart-cast di lambda Compose. -->
    <Match>
        <Bug pattern="BC_UNCONFIRMED_CAST,BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/>
    </Match>

    <!-- Metode privat yang hanya dipanggil dari lambda/akses sintetis. -->
    <Match>
        <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
    </Match>
    <!-- Batch 203 (permintaan user: noise yang tak bisa jadi landasan perbaikan DISINGKIRKAN). Tiap blok di bawah
         diverifikasi terhadap laporan CI run2 (285 temuan) + sumber v202. Hapus satu blok untuk memulihkan pattern-nya. -->

    <!-- Parameter `$composer: Composer?` hasil Compose compiler terbaca "nullable tapi tak dicek" (142 temuan; semua
         lokasi yang terlihat = pemanggilan Row/Column/Text/SkeuButton atau baris 0). Kotlin murni tidak bisa
         menghasilkan pola ini dari kode sendiri (param nullable tanpa cek = galat kompilasi). -->
    <Match>
        <Bug pattern="NP_PARAMETER_MUST_BE_NONNULL_BUT_MARKED_AS_NULLABLE"/>
    </Match>

    <!-- `instanceof` dan cast koleksi di dalam fungsi inline Compose/stdlib (59 temuan): semua nomor baris jatuh DI LUAR
         panjang file sumbernya = isi fungsi inline dari berkas lain, bukan kode proyek. -->
    <Match>
        <Bug pattern="BC_VACUOUS_INSTANCEOF,BC_BAD_CAST_TO_ABSTRACT_COLLECTION"/>
    </Match>

    <!-- Nilai kembali delegasi state, fungsi `suspend`, dan pemanggilan Composable dibaca "bisa null" (36 temuan; seluruhnya
         terlihat di laporan, tidak ada satu pun akses null nyata). -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>

    <!-- Fungsi `@Composable` wajib PascalCase (konvensi Compose): 16 temuan, semuanya fungsi @Composable. -->
    <Match>
        <Bug pattern="NM_METHOD_NAMING_CONVENTION"/>
    </Match>

    <!-- Artefak kompilator Kotlin/Compose pada 1 titik masing-masing: mask `$default`/`$changed` di baris tanda tangan
         `BoosterScreen` (BIT_AND_ZZ), elvis `?: return` (NP_LOAD_OF_KNOWN_NULL_VALUE), bytecode tanpa nomor baris
         (NP_NONNULL_PARAM_VIOLATION, UpdateManager), dan `Random(180L)` BERSEED sengaja yang dipakai di dua loop inline
         (DMI_RANDOM_USED_ONLY_ONCE, tekstur butiran deterministik). -->
    <Match>
        <Bug pattern="BIT_AND_ZZ,NP_LOAD_OF_KNOWN_NULL_VALUE,NP_NONNULL_PARAM_VIOLATION,DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>

    <!-- Field `$stable` yang disisipkan Compose compiler tiap kelas dibaca "tak pernah dibaca". Hanya field bernama
         `$stable`: UUF lain (bila ada) TETAP dilaporkan. -->
    <Match>
        <Bug pattern="UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD"/>
        <Field name="$stable"/>
    </Match>

    <!-- Batch 205 (triase laporan CI run5: SpotBugs 12 temuan; DE_*/RV_* diperbaiki di kode, 4 sisanya di bawah = bukan bug).
         SA_FIELD_SELF_ASSIGNMENT (2 temuan, SkeuomorphicComponents.kt baris 1502 & 2040): keduanya jatuh tepat di baris
         pembuka lambda `pointerInput { awaitEachGesture { ... } }` = state-machine coroutine hasil kompilator; sumbernya
         tak punya penugasan field ke dirinya sendiri (grep nihil). Hanya pattern ini di kelas ini yang disaring. -->
    <Match>
        <Bug pattern="SA_FIELD_SELF_ASSIGNMENT"/>
        <Class name="~.*SkeuomorphicComponents.*"/>
    </Match>

    <!-- ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD (2 temuan, AudioEnhancerService.kt baris 519 `onStartCommand` & 614
         `onDestroy`): penulisan `isRunning` (companion, @Volatile, private set) dari Service itu SENGAJA — bendera proses
         tunggal yang dibaca watchdog/widget/QS Tile (alasan di komentar Batch 45); Service Android = satu instance. -->
    <Match>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
        <Class name="com.audioenhancer.booster.AudioEnhancerService"/>
    </Match>
</FindBugsFilter>
