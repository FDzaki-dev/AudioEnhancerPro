<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 213 (revisi B212): pelat timbul Neumorphism burgundy — STATIS (tak ikut state). Sumur teks yang dulu ikut digambar
     di sini DIPINDAH ke widget_panel_off/on.xml (view tersendiri) supaya berganti timbul/cekung bareng knob.
     Layer-list murni (tanpa bitmap/Canvas). Bayangan blur = tumpukan layer alpha-bertingkat (profil Gaussian, sigma 1.6dp);
     6dp di tepi = RUANG INSET bayangan, radius pelat = radius sistem peluncur di values-v31 (API 31+).
     Gelap kanan-bawah (+2dp), sorot kiri-atas (-2dp). Dihasilkan skrip; ubah angka lewat skrip. -->
