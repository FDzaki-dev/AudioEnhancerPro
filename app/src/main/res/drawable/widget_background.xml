<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 33: AMOLED Glassmorphism Hybrid + Midnight Blue Gradient. RemoteViews
     gak dukung Compose brush, jadi tint Midnight Blue disimulasikan lewat gradient
     3-stop XML (AMOLED -> midnight tint tipis -> glass elevated), arah 135° konsisten
     sama arah cahaya top-left->bottom-right di Theme.kt/SkeuomorphicComponents.kt. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="135"
        android:startColor="#101722"
        android:centerColor="#0F1330"
        android:endColor="#030508" />
</shape>
