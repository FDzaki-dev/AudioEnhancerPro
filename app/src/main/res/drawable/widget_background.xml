<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 34: Premium AMOLED Hybrid Glassmorphism + Subtle Midnight Blue. RemoteViews
     gak dukung Compose Brush, jadi §6 "Correct use" (GlassElevated -> MidnightBlue tint
     6% -> AmoledBlack) disimulasikan lewat gradient 3-stop XML. centerColor #0B101B =
     GlassElevated di-mix 6% ke MidnightBlue (bukan 8% kayak Batch 33 — guide baru
     eksplisit `MidnightBlueAmbientAlpha = 0.06f`). Angle 135° konsisten arah cahaya
     top-left->bottom-right (guide §9), dipakai walau widget termasuk tactile micro
     bukan kartu struktural. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="135"
        android:startColor="#101722"
        android:centerColor="#0B101B"
        android:endColor="#030508" />
</shape>
