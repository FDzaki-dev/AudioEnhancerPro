<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 215: knob daya, NONAKTIF = cembung/timbul + ikon daya redup. Kotak desain 56dp (muka 48dp + ruang bayangan 4dp).
     Muka 3 nada (ruby-rose -> burgundy -> plum) + kilau specular kiri-atas. Nama "status_dot" dipertahankan dari versi lama
     (referensi R.drawable tetap). Dihasilkan skrip.
     Batch 224: SELURUH layer muka/bayangan/cincin diubah dari oval ke bentuk "leaf" (rectangle, pojok kiri-atas & kanan-bawah = 50% sisi, kanan-atas & kiri-bawah = 10% sisi,
     dihitung per layer dari diameter 56dp dikurangi inset) selaras knob daya di app (NeumoKnobCorners). Jangkar transparan tetap oval. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Jangkar ukuran: memberi drawable intrinsic size 56dp x 56dp. ImageView (fitCenter) lalu menskala SELURUH knob
         (muka + bayangan + ikon) secara seragam saat widget pendek; tanpa jangkar geometri dp akan rusak. -->
    <item android:width="56dp" android:height="56dp" android:gravity="center">
        <shape android:shape="oval"><solid android:color="#00000000" /></shape>
    </item>
    <!-- Bayangan sorot (terang, kiri-atas) -->
    <item android:left="0dp" android:top="0dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="26.5dp" android:topRightRadius="5.3dp" android:bottomRightRadius="26.5dp" android:bottomLeftRadius="5.3dp" /><solid android:color="#01D8607F" /></shape>
    </item>
    <item android:left="0.5dp" android:top="0.5dp" android:right="3.5dp" android:bottom="3.5dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="26dp" android:topRightRadius="5.2dp" android:bottomRightRadius="26dp" android:bottomLeftRadius="5.2dp" /><solid android:color="#02D8607F" /></shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="25.5dp" android:topRightRadius="5.1dp" android:bottomRightRadius="25.5dp" android:bottomLeftRadius="5.1dp" /><solid android:color="#03D8607F" /></shape>
    </item>
    <item android:left="1.5dp" android:top="1.5dp" android:right="4.5dp" android:bottom="4.5dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="25dp" android:topRightRadius="5dp" android:bottomRightRadius="25dp" android:bottomLeftRadius="5dp" /><solid android:color="#06D8607F" /></shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="24.5dp" android:topRightRadius="4.9dp" android:bottomRightRadius="24.5dp" android:bottomLeftRadius="4.9dp" /><solid android:color="#0AD8607F" /></shape>
    </item>
    <item android:left="2.5dp" android:top="2.5dp" android:right="5.5dp" android:bottom="5.5dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="24dp" android:topRightRadius="4.8dp" android:bottomRightRadius="24dp" android:bottomLeftRadius="4.8dp" /><solid android:color="#0DD8607F" /></shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="23.5dp" android:topRightRadius="4.7dp" android:bottomRightRadius="23.5dp" android:bottomLeftRadius="4.7dp" /><solid android:color="#0DD8607F" /></shape>
    </item>
    <item android:left="3.5dp" android:top="3.5dp" android:right="6.5dp" android:bottom="6.5dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="23dp" android:topRightRadius="4.6dp" android:bottomRightRadius="23dp" android:bottomLeftRadius="4.6dp" /><solid android:color="#0CD8607F" /></shape>
    </item>
    <!-- Bayangan gelap (kanan-bawah) -->
    <item android:left="3dp" android:top="3dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="26.5dp" android:topRightRadius="5.3dp" android:bottomRightRadius="26.5dp" android:bottomLeftRadius="5.3dp" /><solid android:color="#021A0412" /></shape>
    </item>
    <item android:left="3.5dp" android:top="3.5dp" android:right="0.5dp" android:bottom="0.5dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="26dp" android:topRightRadius="5.2dp" android:bottomRightRadius="26dp" android:bottomLeftRadius="5.2dp" /><solid android:color="#041A0412" /></shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="25.5dp" android:topRightRadius="5.1dp" android:bottomRightRadius="25.5dp" android:bottomLeftRadius="5.1dp" /><solid android:color="#081A0412" /></shape>
    </item>
    <item android:left="4.5dp" android:top="4.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="25dp" android:topRightRadius="5dp" android:bottomRightRadius="25dp" android:bottomLeftRadius="5dp" /><solid android:color="#101A0412" /></shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="24.5dp" android:topRightRadius="4.9dp" android:bottomRightRadius="24.5dp" android:bottomLeftRadius="4.9dp" /><solid android:color="#191A0412" /></shape>
    </item>
    <item android:left="5.5dp" android:top="5.5dp" android:right="2.5dp" android:bottom="2.5dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="24dp" android:topRightRadius="4.8dp" android:bottomRightRadius="24dp" android:bottomLeftRadius="4.8dp" /><solid android:color="#231A0412" /></shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="23.5dp" android:topRightRadius="4.7dp" android:bottomRightRadius="23.5dp" android:bottomLeftRadius="4.7dp" /><solid android:color="#281A0412" /></shape>
    </item>
    <item android:left="6.5dp" android:top="6.5dp" android:right="3.5dp" android:bottom="3.5dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="23dp" android:topRightRadius="4.6dp" android:bottomRightRadius="23dp" android:bottomLeftRadius="4.6dp" /><solid android:color="#271A0412" /></shape>
    </item>
    <!-- Muka knob cembung (timbul), gradasi 3 nada -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="24dp" android:topRightRadius="4.8dp" android:bottomRightRadius="24dp" android:bottomLeftRadius="4.8dp" />
            <gradient android:angle="315" android:startColor="@color/widget_raised_start" android:centerColor="@color/widget_raised_mid" android:endColor="@color/widget_raised_end" />
            <stroke android:width="0.75dp" android:color="@color/widget_rim" />
        </shape>
    </item>
    <!-- Kilau specular kiri-atas (radial rose-terang memudar) -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="24dp" android:topRightRadius="4.8dp" android:bottomRightRadius="24dp" android:bottomLeftRadius="4.8dp" />
            <gradient android:type="radial" android:centerX="0.3" android:centerY="0.25" android:gradientRadius="62%"
                android:startColor="#4CFFC2D0" android:centerColor="#14FFC2D0" android:endColor="#00FFC2D0" />
        </shape>
    </item>
    <!-- Batch 216 dekorasi: cincin tanda ukur dial. 24 tik = stroke putus-putus di jalur leaf D39dp (keliling ~135,9dp / 24 = pitch 5,66dp = tik 1,2dp + celah 4,46dp; B224);
         alur ukir tipis di dalam tepi muka. Murni layer drawable, 0 bitmap. -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="22dp" android:topRightRadius="4.4dp" android:bottomRightRadius="22dp" android:bottomLeftRadius="4.4dp" /><stroke android:width="0.5dp" android:color="#1FFFC2D0" /></shape>
    </item>
    <item android:left="8.5dp" android:top="8.5dp" android:right="8.5dp" android:bottom="8.5dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="19.5dp" android:topRightRadius="3.9dp" android:bottomRightRadius="19.5dp" android:bottomLeftRadius="3.9dp" /><stroke android:width="2dp" android:color="#47FFC2D0" android:dashWidth="1.2dp" android:dashGap="4.46dp" /></shape>
    </item>
    <item android:width="22dp" android:height="22dp" android:gravity="center">
        <vector
            android:width="22dp" android:height="22dp" android:viewportWidth="24" android:viewportHeight="24">
            <path android:fillColor="@color/widget_glyph_off" android:pathData="M13,3h-2v10h2V3zm4.83,2.17l-1.42,1.42C17.99,7.86 19,9.81 19,12c0,3.87 -3.13,7 -7,7s-7,-3.13 -7,-7c0,-2.19 1.01,-4.14 2.58,-5.42L6.17,5.17C4.23,6.82 3,9.26 3,12c0,4.97 4.03,9 9,9s9,-4.03 9,-9c0,-2.74 -1.23,-5.18 -3.17,-6.83z" />
        </vector>
    </item>
</layer-list>
