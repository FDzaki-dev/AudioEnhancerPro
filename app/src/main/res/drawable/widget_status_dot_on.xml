<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 215: knob daya, AKTIF = cekung/tertekan + ikon daya menyala bercahaya. Kotak desain 56dp identik dgn _off. Dihasilkan skrip.
     Batch 224: layer rongga/halo/cincin diubah dari oval ke bentuk "leaf" (pola sama dgn _off); pendar ikon (radial 34dp) tetap bulat (cahaya lembut). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Jangkar ukuran: memberi drawable intrinsic size 56dp x 56dp. ImageView (fitCenter) lalu menskala SELURUH knob
         (muka + bayangan + ikon) secara seragam saat widget pendek; tanpa jangkar geometri dp akan rusak. -->
    <item android:width="56dp" android:height="56dp" android:gravity="center">
        <shape android:shape="oval"><solid android:color="#00000000" /></shape>
    </item>
    <!-- Rongga cekung: dasar gradasi plum gelap (kiri-atas) -> burgundy (kanan-bawah) -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="24dp" android:topRightRadius="4.8dp" android:bottomRightRadius="24dp" android:bottomLeftRadius="4.8dp" />
            <gradient android:angle="315" android:startColor="@color/widget_well_start" android:endColor="@color/widget_well_end" />
        </shape>
    </item>
    <!-- Bayangan dalam kiri-atas: radial berpusat ke kanan-bawah -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="24dp" android:topRightRadius="4.8dp" android:bottomRightRadius="24dp" android:bottomLeftRadius="4.8dp" />
            <gradient android:type="radial" android:centerX="0.62" android:centerY="0.62" android:gradientRadius="80%"
                android:startColor="#001A0412" android:centerColor="#001A0412" android:endColor="#CC1A0412" />
        </shape>
    </item>
    <!-- Sorot dalam kanan-bawah: radial berpusat ke kiri-atas -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="24dp" android:topRightRadius="4.8dp" android:bottomRightRadius="24dp" android:bottomLeftRadius="4.8dp" />
            <gradient android:type="radial" android:centerX="0.38" android:centerY="0.38" android:gradientRadius="80%"
                android:startColor="#00D8607F" android:centerColor="#00D8607F" android:endColor="#4CD8607F" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="24dp" android:topRightRadius="4.8dp" android:bottomRightRadius="24dp" android:bottomLeftRadius="4.8dp" /><stroke android:width="0.5dp" android:color="#1FD8607F" /></shape>
    </item>
    <!-- Halo cincin: lingkaran cahaya lembut di luar muka (ruang bayangan 4dp) — kesan LED menyala -->
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="26.5dp" android:topRightRadius="5.3dp" android:bottomRightRadius="26.5dp" android:bottomLeftRadius="5.3dp" /><stroke android:width="1dp" android:color="#1FFF6F8A" /></shape>
    </item>
    <item android:left="2.5dp" android:top="2.5dp" android:right="2.5dp" android:bottom="2.5dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="25.5dp" android:topRightRadius="5.1dp" android:bottomRightRadius="25.5dp" android:bottomLeftRadius="5.1dp" /><stroke android:width="1.5dp" android:color="#59FF6F8A" /></shape>
    </item>
    <!-- Batch 216 dekorasi: cincin tanda ukur dial NYALA (24 tik rose, stroke putus-putus di jalur leaf D39dp: keliling ~135,9dp / 24 = pitch 5,66dp = tik 1,2dp + celah 4,46dp (B224))
         + alur ukir tipis di dalam tepi rongga. Murni layer drawable, 0 bitmap. -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="22dp" android:topRightRadius="4.4dp" android:bottomRightRadius="22dp" android:bottomLeftRadius="4.4dp" /><stroke android:width="0.5dp" android:color="#1AFFB3C4" /></shape>
    </item>
    <item android:left="8.5dp" android:top="8.5dp" android:right="8.5dp" android:bottom="8.5dp">
        <shape android:shape="rectangle"><corners android:topLeftRadius="19.5dp" android:topRightRadius="3.9dp" android:bottomRightRadius="19.5dp" android:bottomLeftRadius="3.9dp" /><stroke android:width="2dp" android:color="#8CFF6F8A" android:dashWidth="1.2dp" android:dashGap="4.46dp" /></shape>
    </item>
    <!-- Cahaya ikon (LED menyala): inti rose-terang -> rose -> memudar -->
    <item android:width="34dp" android:height="34dp" android:gravity="center">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="50%" android:startColor="#8CFF6F8A" android:centerColor="#33FF6F8A" android:endColor="#00FF6F8A" />
        </shape>
    </item>
    <item android:width="22dp" android:height="22dp" android:gravity="center">
        <vector
            android:width="22dp" android:height="22dp" android:viewportWidth="24" android:viewportHeight="24">
            <path android:fillColor="@color/widget_glyph_on" android:pathData="M13,3h-2v10h2V3zm4.83,2.17l-1.42,1.42C17.99,7.86 19,9.81 19,12c0,3.87 -3.13,7 -7,7s-7,-3.13 -7,-7c0,-2.19 1.01,-4.14 2.58,-5.42L6.17,5.17C4.23,6.82 3,9.26 3,12c0,4.97 4.03,9 9,9s9,-4.03 9,-9c0,-2.74 -1.23,-5.18 -3.17,-6.83z" />
        </vector>
    </item>
</layer-list>
