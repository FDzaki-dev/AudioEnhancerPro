<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 213: panel teks, NONAKTIF = TIMBUL (raised), sepasang dgn knob timbul. Bounds = view panel; 4dp tepi = ruang bayangan.
     Dihasilkan skrip. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bayangan sorot (terang, kiri-atas) -->
    <item android:left="0dp" android:top="0dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#01C0506C" /></shape>
    </item>
    <item android:left="0.5dp" android:top="0.5dp" android:right="3.5dp" android:bottom="3.5dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#01C0506C" /></shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#03C0506C" /></shape>
    </item>
    <item android:left="1.5dp" android:top="1.5dp" android:right="4.5dp" android:bottom="4.5dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#06C0506C" /></shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#09C0506C" /></shape>
    </item>
    <item android:left="2.5dp" android:top="2.5dp" android:right="5.5dp" android:bottom="5.5dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#0CC0506C" /></shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#0CC0506C" /></shape>
    </item>
    <item android:left="3.5dp" android:top="3.5dp" android:right="6.5dp" android:bottom="6.5dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#0AC0506C" /></shape>
    </item>
    <!-- Bayangan gelap (kanan-bawah) -->
    <item android:left="3dp" android:top="3dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#021C040A" /></shape>
    </item>
    <item android:left="3.5dp" android:top="3.5dp" android:right="0.5dp" android:bottom="0.5dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#031C040A" /></shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#081C040A" /></shape>
    </item>
    <item android:left="4.5dp" android:top="4.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#0F1C040A" /></shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#181C040A" /></shape>
    </item>
    <item android:left="5.5dp" android:top="5.5dp" android:right="2.5dp" android:bottom="2.5dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#201C040A" /></shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#251C040A" /></shape>
    </item>
    <item android:left="6.5dp" android:top="6.5dp" android:right="3.5dp" android:bottom="3.5dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" /><solid android:color="#231C040A" /></shape>
    </item>
    <!-- Muka panel cembung: sedikit lebih terang dari pelat + kilau atas + peredupan bawah -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="315" android:startColor="@color/widget_panel_light" android:endColor="@color/widget_panel_dark" />
            <stroke android:width="0.75dp" android:color="@color/widget_rim" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" />
            <gradient android:angle="270" android:startColor="#29C0506C" android:centerColor="#00C0506C" android:endColor="#00C0506C" /></shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle"><corners android:radius="24dp" />
            <gradient android:angle="90" android:startColor="#331C040A" android:centerColor="#001C040A" android:endColor="#001C040A" /></shape>
    </item>
</layer-list>
