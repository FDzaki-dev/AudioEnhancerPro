<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews cuma dukung subset View terbatas (LinearLayout/FrameLayout/RelativeLayout,
     TextView, ImageView, Button, dst) — gak bisa Compose/Material3 kayak layar utama app.
     Warna dibakar langsung (match sama ServiceStatusBadge di MainActivity.kt), bukan
     theme attr, biar konsisten sama fix v1.41/v1.42. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <ImageView
        android:id="@+id/widget_status_dot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/qs_tile_subtitle_off"
        android:src="@drawable/widget_status_dot_off" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qs_tile_label"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qs_tile_subtitle_off"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
