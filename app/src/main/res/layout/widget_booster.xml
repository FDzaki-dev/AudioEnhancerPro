<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 212: rombak total — Neumorphism burgundy (pelat timbul + knob daya + sumur tampilan).
     RemoteViews cuma dukung subset View (LinearLayout/FrameLayout/TextView/ImageView...; <View> polos DILARANG),
     jadi knob = FrameLayout ber-background (BUKAN ImageView/src: background tak diskalakan intrinsic size drawable,
     geometri layer-list dalam dp tetap persis). Seluruh kartu = 1 target tap (widget_root) -> toggle, perilaku lama.
     INSET: padding root + drawable background menyisakan 8dp ruang bayangan di tepi widget (hormati sudut peluncur,
     radius = sistem di API 31+). Angka dp di sini HARUS sinkron dgn widget_background.xml (lihat values/widget_theme.xml).
     Aksesibilitas: dekorasi (knob) importantForAccessibility=no; TalkBack membaca "Boomly" + "Aktif/Nonaktif" dari teks. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/widget_padding_start"
    android:paddingTop="@dimen/widget_padding_vertical"
    android:paddingEnd="@dimen/widget_padding_end"
    android:paddingBottom="@dimen/widget_padding_vertical">

    <FrameLayout
        android:id="@+id/widget_knob"
        android:layout_width="@dimen/widget_knob_size"
        android:layout_height="@dimen/widget_knob_size"
        android:background="@drawable/widget_status_dot_off"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/widget_text_margin_start"
        android:layout_marginEnd="@dimen/widget_text_margin_end"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="@string/qs_tile_label"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:text="@string/qs_tile_subtitle_off"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
