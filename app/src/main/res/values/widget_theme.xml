<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 325 (rombak total dari Neumorphism burgundy B212-B228): token widget beranda bertema SPACE, satu sumber untuk layout + drawable widget.
     Palet = tema Space di app (Theme.kt: SpaceVoid/Background/Surface/CardLight/CardDark/Accent/Secondary/Gold + magenta nebula). Overlay ber-alpha di drawable
     (bayangan, kabut nebula, kilau, bintang) memakai RGB turunan palet ini dgn alpha bertingkat hasil skrip (docs/widget_space_gen.py), jadi tidak bisa @color tunggal.
     Nama token yang dibaca BoosterWidgetProvider/layout DIPERTAHANKAN (widget_text_*, widget_eq_on/off); token Neumorphism lama (plate/raised/well/rim/midnight) dihapus. -->
<resources>
    <color name="widget_void">#04050E</color>  <!-- Void / kedalaman ruang (SpaceVoid): dasar sumur Aktif, ujung gradasi pelat. -->
    <color name="widget_gem">#2B3A8A</color>  <!-- Tepi permata knob Nonaktif (indigo terang, di atasnya bevel kiri-atas). -->
    <color name="widget_deep">#070A1C</color>  <!-- SpaceBackground: dasar knob Aktif, tengah gradasi pelat. -->
    <color name="widget_surface">#0B1030</color>  <!-- SpaceSurface: tengah gradasi panel. -->
    <color name="widget_card_light">#1A2354</color>  <!-- SpaceCardLight: sisi terang kartu/panel Nonaktif, dasar knob Nonaktif. -->
    <color name="widget_card_dark">#0F1537</color>  <!-- SpaceCardDark: awal gradasi muka pelat. -->
    <color name="widget_text_primary">#EEF2FF</color>  <!-- Judul: #EEF2FF di atas panel (kontras terukur di pratinjau). -->
    <color name="widget_text_secondary">#BAC6F0</color>  <!-- Status Nonaktif. -->
    <color name="widget_text_active">#7DE3FF</color>  <!-- Status Aktif (cyan). -->
    <color name="widget_glyph_off">#8A97C6</color>  <!-- Ikon daya + satelit knob Nonaktif. -->
    <color name="widget_glyph_on">#7DE3FF</color>  <!-- Ikon daya knob Aktif. -->
    <color name="widget_eq_off">#7482B8</color>  <!-- Bar equalizer dekoratif Nonaktif (setColorFilter di provider). -->
    <color name="widget_eq_on">#7DE3FF</color>  <!-- Bar equalizer dekoratif Aktif (setColorFilter di provider). -->

    <!-- INSET. Ruang bayangan/aura pelat 6dp (di widget_background.xml) + padding root 8dp + ruang bayangan knob/panel 4dp (di dalam drawable masing-masing) =>
         muka knob/panel berjarak 8+4=12dp dari tepi widget = 6dp dari tepi pelat (cincin 5dp pelat + bintang-bintangnya terlihat di sana). -->
    <dimen name="widget_padding">8dp</dimen>
    <dimen name="widget_knob_max_size">56dp</dimen>
    <!-- Padding dalam panel = ruang bayangan 4dp + napas teks 12dp. -->
    <dimen name="widget_panel_padding">16dp</dimen>
    <!-- Radius pelat (pojok besar kiri-atas). Android 12+ mengganti dgn radius sistem peluncur (values-v31). -->
    <dimen name="widget_corner_radius">22dp</dimen>
    <!-- Batch 325: pojok kecil bahasa "orbit" Space = 6dp (SpaceOrbitCorners 44/6/6/6): dipakai 3 pojok lain pelat. Panel teks kebalikannya (24dp/6dp literal di widget_panel_*.xml). -->
    <dimen name="widget_corner_radius_small">6dp</dimen>
</resources>
