<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 215 (revisi B213/B212): token widget beranda — Neumorphism burgundy, GRADASI 3 NADA (ruby-rose -> burgundy -> plum).
     Satu sumber untuk layout + drawable widget. Bayangan & overlay alpha di drawable (widget_background / widget_status_dot_* /
     widget_panel_*) memakai RGB 1A0412 (gelap), D8607F (sorot), FFC2D0 (specular), FF6F8A (pendar) dgn alpha bertingkat hasil skrip,
     jadi tidak bisa merujuk @color tunggal; nilai itu = turunan palet ini. Tanpa emas (aturan tema Old Money). -->
<resources>
    <!-- Pelat (statis): ruby-rose kiri-atas -> burgundy tengah -> plum gelap kanan-bawah (arah cahaya sama dgn tema Neumorphism app). -->
    <color name="widget_plate_start">#A82D4B</color>
    <color name="widget_plate_mid">#6E1733</color>
    <color name="widget_plate_end">#3A0C26</color>
    <!-- Muka TIMBUL (knob & panel saat Nonaktif): sedikit lebih terang dari pelat agar terbaca sebagai bidang terangkat.
         Judul #F8E8EB di atas raised_start >= 5:1; status #D9B0BA di atas raised_end >= 7:1. -->
    <color name="widget_raised_start">#AE3553</color>
    <color name="widget_raised_mid">#82223F</color>
    <color name="widget_raised_end">#4C1230</color>
    <!-- Dasar rongga CEKUNG (knob & panel saat Aktif): plum gelap kiri-atas -> burgundy kanan-bawah + garis tepi tipis 15% rose. -->
    <color name="widget_well_start">#2A0818</color>
    <color name="widget_well_end">#4A1030</color>
    <color name="widget_rim">#26FFB3C4</color>
    <!-- Teks: gading-rose di atas burgundy (kontras >= 8:1 utk judul, >= 5:1 utk status). -->
    <color name="widget_text_primary">#F8E8EB</color>
    <color name="widget_text_secondary">#D9B0BA</color>
    <color name="widget_text_active">#FFB6C4</color>
    <!-- Ikon daya: redup (nonaktif, >= 3:1 thd pelat) / menyala (aktif). -->
    <color name="widget_glyph_off">#B98090</color>
    <color name="widget_glyph_on">#FF7D95</color>
    <!-- Bar equalizer dekoratif: redup (Nonaktif) / menyala (Aktif); ditint lewat setColorFilter di provider. -->
    <color name="widget_eq_off">#A8627A</color>
    <color name="widget_eq_on">#FF7D95</color>

    <!-- INSET. Ruang bayangan pelat 6dp (di widget_background.xml) + padding root 8dp + ruang bayangan knob/panel 4dp (di dalam
         drawable masing-masing) => muka knob/panel berjarak 8+4=12dp dari tepi widget = 6dp dari tepi pelat. Knob & panel menyusut
         mengikuti tinggi widget (knob: ImageView adjustViewBounds, maks 56dp; panel: match_parent). -->
    <dimen name="widget_padding">8dp</dimen>
    <dimen name="widget_knob_max_size">56dp</dimen>
    <!-- Padding dalam panel = ruang bayangan 4dp + napas teks 12dp. -->
    <dimen name="widget_panel_padding">16dp</dimen>
    <!-- Radius pelat. Android 12+ mengganti dgn radius sistem peluncur (values-v31). -->
    <dimen name="widget_corner_radius">22dp</dimen>
</resources>
