<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Batch 195: getar bilah tab langsung via Vibrator (izin normal, otomatis diberikan, tanpa dialog). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Batch 246 (PROBE, request user "Teruskan ke reverb izin dump"): izin `DUMP` TIDAK diberikan otomatis (signature|privileged|development).
         Hanya aktif bila user menjalankan sekali: adb shell pm grant com.audioenhancer.booster android.permission.DUMP
         (atau, sejak Batch 250, lewat tombol "Aktifkan Reverb" di kartu Reverb yang memakai Shizuku). Tanpa izin = nol perubahan perilaku. Dipakai `DumpProbe` untuk MEMBACA session pemutar (dumpsys), bukan mengubah suara. -->
    <uses-permission android:name="android.permission.DUMP" tools:ignore="ProtectedPermissions" />
    <!-- Batch 120 (Fase 8E, spectrum visualizer): WAJIB untuk Visualizer AudioEffect di
         session 0 (mixer global) - beda dari Visualizer di sesi App sendiri yang tidak
         butuh izin ini. Runtime request ada di Part 2 (UI, belum dikerjakan) - deklarasi
         manifest saja TIDAK memunculkan dialog izin ke user. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Batch 127 (fast-recovery watchdog) — STATUS Batch 132: heartbeat exact alarm
         DINONAKTIFKAN permanen (`ServiceWatchdogWorker.scheduleExactRecovery()` no-op,
         demi baterai). Izin ini sekarang tidak dipakai untuk menjadwalkan alarm baru
         dan TIDAK ada UI permintaan izinnya (kartu "Pemulihan Cepat" dihapus Batch 128).
         Dibiarkan di manifest (0 dampak) — pemulihan HANYA lewat watchdog 15 menit
         WorkManager. Cabut hanya atas instruksi eksplisit user. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Fitur baru: in-app update (diminta user eksplisit, lihat UpdateManager.kt).
         INTERNET: PERTAMA KALI app ini butuh network sama sekali (cek+unduh Release
         GitHub) — sebelumnya app 100% offline. REQUEST_INSTALL_PACKAGES: pasang APK
         hasil unduhan via intent instalasi (FileProvider di bawah). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Batch 250: izinkan Boomly melihat/membuka aplikasi Shizuku (Android 11+ menyembunyikan paket lain tanpa <queries>).
         Dipakai tombol di kartu Reverb: "Buka Shizuku" bila terpasang, selain itu membuka halaman unduhnya. -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".AudioEnhancerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.App.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".AudioEnhancerService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".QuickToggleTileService"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_qs_tile"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Batch 127: dipicu HANYA via PendingIntent internal AlarmManager
             (exported=false, bukan implicit broadcast publik). DORMAN sejak Batch 132
             (tidak ada alarm baru); dipertahankan buat alarm sisa di device existing. -->
        <receiver
            android:name=".WatchdogAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".BoosterWidgetProvider"
            android:enabled="true"
            android:exported="true"
            android:label="@string/qs_tile_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_booster_info" />
        </receiver>

        <!-- Batch 250: penerima binder Shizuku (standar README Shizuku-API). Izin INTERACT_ACROSS_USERS_FULL melindungi
             provider ini dari aplikasi biasa; hanya server Shizuku yang bisa mengirim binder ke sini. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Fitur baru: in-app update (UpdateManager.kt) — expose APK hasil unduhan
             di cacheDir/updates/ ke intent instalasi sistem via content:// URI, TANPA
             perlu android:exported="true"/FLAG_GRANT_READ_URI_PERMISSION global. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
